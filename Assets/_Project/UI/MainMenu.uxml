<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ApplicationStyles.uss" />
    <ui:VisualElement class="screen">
        <ui:VisualElement class="top-line">
            <ui:Label text="SPACE CRAWLER" class="brand" />
            <ui:Label name="profile-xp" text="" class="eyebrow" />
        </ui:VisualElement>
        <ui:VisualElement class="content">
            <ui:Label text="MAIN MENU" class="eyebrow accent" />
            <ui:Label text="Space Crawler" class="title" />
            <ui:Label text="" class="subtitle" />
            <ui:VisualElement class="actions">
                <ui:Button name="new-game" text="New Game" class="primary" />
                <ui:Button name="continue" text="Continue  /  No save available" enabled="false" />
                <ui:Button name="load-game" text="Load Game  /  Unavailable" enabled="false" />
                <ui:Button name="options" text="Options  /  Unavailable" enabled="false" />
                <ui:Button name="exit" text="Exit" />
            </ui:VisualElement>
            <ui:Label name="status" class="status" />
        </ui:VisualElement>
        <ui:Label text="Walk onto a doorway to travel. In co-op, both players must use the same doorway." class="footer" />
        <ui:VisualElement name="steam-controls" style="position: absolute; right: 52px; top: 210px; width: 340px;">
            <ui:Label text="STEAM CO-OP" class="eyebrow accent" />
            <ui:Label name="steam-account" class="footer" style="margin-top: 8px;" />
            <ui:Label name="steam-status" class="description" style="font-size: 14px; white-space: normal; margin-top: 10px; margin-bottom: 10px;" />
            <ui:Button name="steam-associate" text="Link this profile to Steam" tooltip="Associate this profile, its XP and saves with the signed-in Steam account. Existing data is backed up first." />
            <ui:Button name="steam-host" text="Host Co-op" />
            <ui:Button name="steam-join" text="Join Invitation" />
            <ui:Button name="steam-cancel" text="Cancel Session" />
        </ui:VisualElement>
        <ui:VisualElement name="local-session-controls" style="position: absolute; right: 52px; top: 490px; width: 330px; display: none;">
            <ui:Label text="LOCAL TWO-PLAYER SESSION" class="eyebrow accent" />
            <ui:Label text="Direct localhost :7777. Start one host, then join from a second instance. No lobby or matchmaking." class="description" style="font-size: 14px; margin-top: 12px; margin-bottom: 16px;" />
            <ui:Button name="local-host" text="Host Local Session" />
            <ui:Button name="local-join" text="Join Local Session" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
