<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ApplicationStyles.uss" />
    <ui:VisualElement class="gameplay-root" picking-mode="Ignore">
        <ui:VisualElement name="gameplay-hud" class="gameplay-hud" picking-mode="Ignore">
            <ui:VisualElement class="top-line" picking-mode="Ignore">
                <ui:VisualElement picking-mode="Ignore">
                    <ui:Label text="SPACE CRAWLER" class="brand" picking-mode="Ignore" />
                    <ui:Label name="equipped-weapon" text="Equipped weapon" class="eyebrow" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-actions">
                    <ui:Button name="pause" text="Pause  /  Esc" focusable="false" />
                    <ui:Button name="return-to-menu" text="Main Menu" focusable="false" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="run-readout" text="Loading generated room..." picking-mode="Ignore" style="white-space: normal; color: rgb(155, 185, 196); margin-top: 12px; font-size: 13px;" />
            <ui:ProgressBar name="player-health" low-value="0" high-value="100" value="100" title="Health 100 / 100" picking-mode="Ignore" style="width: 260px; margin-top: 12px;" />
            <ui:Label name="health-status" text="" picking-mode="Ignore" style="white-space: normal;" />
            <ui:Label name="completion-hint" text="" class="description accent" picking-mode="Ignore" />
            <ui:VisualElement class="hud-spacer" picking-mode="Ignore" />
            <ui:Label text="MOVE  WASD / ARROWS / LEFT STICK     AIM  POINTER / RIGHT STICK     PAUSE  ESC / START" class="controls" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="pause-overlay" class="pause-overlay">
            <ui:VisualElement class="pause-card">
                <ui:Label text="SPACE CRAWLER" class="eyebrow accent" />
                <ui:Label text="Paused" class="title" />
                <ui:Label text="" class="subtitle" />
                <ui:Button name="resume" text="Resume" class="primary" />
                <ui:Button name="options" text="Options — unavailable" />
                <ui:Button name="pause-return-to-menu" text="Return to Main Menu" />
                <ui:Label name="pause-hint" text="Release movement controls before resuming.&#10;Focus loss pauses gameplay automatically." class="description pause-hint" />
                <ui:Label name="status" class="status" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="completion-overlay" class="pause-overlay" style="display: none;">
            <ui:VisualElement class="pause-card">
                <ui:Label text="Run Complete" class="title" />
                <ui:Label name="completion-rewards" class="description" />
                <ui:Label name="completion-status" class="description" />
                <ui:Button name="completion-return-to-menu" text="Return to Main Menu" class="primary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="death-overlay" class="pause-overlay" style="display: none;">
            <ui:VisualElement class="pause-card">
                <ui:Label text="Run Over" class="title" />
                <ui:Label text="Your run has ended. Earned profile experience is preserved." class="description" style="white-space: normal;" />
                <ui:Button name="death-return-to-menu" text="Return to Main Menu" class="primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
